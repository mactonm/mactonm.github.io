<div class="news">
  {% if site.news != blank %}
    {% assign news = site.news | reverse %}
    {% assign news_size = news | size %}
    {% assign announcements = page.announcements %}
    {% assign is_scrollable = false %}
    {% assign visible_items = 2 %}

    {% if include.limit and announcements and announcements.scrollable %}
      {% assign is_scrollable = true %}
    {% endif %}

    {% if include.limit and announcements and announcements.visible_items %}
      {% assign visible_items = announcements.visible_items | plus: 0 %}
    {% endif %}

    {% assign fallback_max_height = visible_items | times: 8.5 %}

    {% if include.limit and announcements and announcements.limit and is_scrollable != true %}
      {% assign news_limit = announcements.limit %}
    {% else %}
      {% assign news_limit = news_size %}
    {% endif %}

    <div
      class="news-timeline-wrapper {% if is_scrollable and news_size > visible_items %}is-scrollable{% endif %}"
      {% if is_scrollable %}
        style="--news-max-height: {% if announcements.max_height %}{{ announcements.max_height }}{% else %}{{ fallback_max_height }}rem{% endif %};"
      {% endif %}
    >
      <ul class="news-timeline">
        {% for item in news limit: news_limit %}
          <li class="news-timeline-item">
            <time class="news-timeline-date">{{ item.date | date: '%b %Y' }}</time>
            <div class="news-timeline-content">
              {% if item.inline %}
                {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
              {% else %}
                <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
              {% endif %}
            </div>
          </li>
        {% endfor %}
      </ul>
    </div>
  {% else %}
    <p>No news so far...</p>
  {% endif %}
</div>
