{% if project.redirect %}
  {% assign project_url = project.redirect %}
{% else %}
  {% assign project_url = project.url | relative_url %}
{% endif %}
<div class="project-question">
  {% if project.img %}
    {%
      include figure.liquid
      loading="eager"
      path=project.img
      sizes="400px"
      alt="Project thumbnail"
      class="project-image"
    %}
  {% else %}
    <div class="project-image-placeholder" aria-hidden="true"></div>
  {% endif %}
  <p class="project-question-label">{{ project.label | default: 'Project' }}</p>
  <h3>
    <a href="{{ project_url }}">{{ project.title }}</a>
  </h3>
  <p>{{ project.description }}</p>
  <div class="project-question-footer">
    <a href="{{ project_url }}">Explore the project <span aria-hidden="true">&rarr;</span></a>
    {% if project.github %}
      <a href="{{ project.github }}" target="_blank" rel="noopener noreferrer" aria-label="Code repository"><i class="fa-brands fa-github"></i></a>
    {% endif %}
  </div>
</div>
